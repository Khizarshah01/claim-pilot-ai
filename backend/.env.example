# Demo mode runs the whole pipeline offline with canned LLM responses. No keys needed.
DEMO_MODE=true
# Per-step latency (ms) while streaming in demo mode so the live timeline is watchable.
DEMO_STEP_DELAY_MS=650
# Live mode: set DEMO_MODE=false and provide an Anthropic API key.
# ANTHROPIC_API_KEY=
# CLAIMPILOT_MODEL=claude-opus-5-5
CORS_ORIGINS=http://localhost:3000
